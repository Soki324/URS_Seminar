{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Debug Microcontroller - OpenOCD (Container)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "/usr/bin/arm-none-eabi-gdb",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32F446RETx",
            "interface": "swd",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts"
            ],
            "preLaunchTask": "CMake: clean rebuild"
        },
        {
            "name": "Attach to Microcontroller - OpenOCD (Container)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "/usr/bin/arm-none-eabi-gdb",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32F446RETx",
            "interface": "swd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts"
            ]
        }
            ]
}